<?xml version="1.0"?>
<ruleset name="nimbus"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>
        Nimbus PMD ruleset: errorprone, bestpractices, multithreading, performance
        and security categories, excluding rules that produce mostly noise for
        this codebase. Re-enable excluded rules step by step when the findings
        are worked off.
    </description>

    <rule ref="category/java/errorprone.xml">
        <!-- duplicate literal threshold noise -->
        <exclude name="AvoidDuplicateLiterals"/>
        <!-- literals in if conditions are an accepted style here -->
        <exclude name="AvoidLiteralsInIfCondition"/>
        <!-- nullable-field reset pattern is used deliberately -->
        <exclude name="NullAssignment"/>
        <!-- idiomatic assignment-in-condition (reader loops) -->
        <exclude name="AssignmentInOperand"/>
        <!-- migrating java.util.Date to java.time is a dedicated refactoring -->
        <exclude name="ReplaceJavaUtilDate"/>
        <!-- renaming these fields would break the JSON contracts -->
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <!-- CLI tools legitimately terminate the VM -->
        <exclude name="DoNotTerminateVM"/>
        <!-- early continue/return in probing loops is idiomatic -->
        <exclude name="AvoidBranchingStatementAsLastInLoop"/>
    </rule>
    <!-- deliberate ignore-probes use commented catch blocks -->
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="allowCommentedBlocks" value="true"/>
        </properties>
    </rule>
    <rule ref="category/java/bestpractices.xml">
        <!-- SLF4J parameterized logging does not need isDebugEnabled guards -->
        <exclude name="GuardLogStatement"/>
        <!-- declaring List/Map instead of concrete impls is planned, not enforced -->
        <exclude name="LooseCoupling"/>
        <!-- CLI tools legitimately print to stdout and stderr -->
        <exclude name="SystemPrintln"/>
        <exclude name="AvoidPrintStackTrace"/>
        <!-- style choice: keep parameter reassignment rare but allowed -->
        <exclude name="AvoidReassigningParameters"/>
        <!-- parameters of interface/override methods cannot be removed -->
        <exclude name="UnusedFormalParameter"/>
        <!-- one declaration per line is style, spotless handles layout -->
        <exclude name="OneDeclarationPerLine"/>
        <!-- loop variable reassignment is used for reader-style loops -->
        <exclude name="AvoidReassigningLoopVariables"/>
        <!-- switch style rules conflict with exhaustive enum switches -->
        <exclude name="ExhaustiveSwitchHasDefault"/>
        <exclude name="NonExhaustiveSwitch"/>
        <exclude name="DefaultLabelNotLastInSwitch"/>
        <!-- array parameter APIs are kept stable -->
        <exclude name="UseVarargs"/>
        <!-- EnumSet/EnumMap migration is a nice-to-have -->
        <exclude name="UseEnumCollections"/>
        <!-- marker interfaces / base classes are used deliberately -->
        <exclude name="AbstractClassWithoutAbstractMethod"/>
    </rule>
    <rule ref="category/java/multithreading.xml">
        <!-- J2EE rule: threads are fine in Spring Boot / Kubernetes pods -->
        <exclude name="DoNotUseThreads"/>
        <!-- heuristic produces too many false positives -->
        <exclude name="UseConcurrentHashMap"/>
        <!-- volatile/synchronized are deliberate concurrency tools here -->
        <exclude name="AvoidUsingVolatile"/>
        <exclude name="AvoidSynchronizedStatement"/>
        <exclude name="AvoidSynchronizedAtMethodLevel"/>
    </rule>
    <rule ref="category/java/performance.xml">
        <!-- lombok @Builder.Default requires explicit field initializers -->
        <exclude name="RedundantFieldInitializer"/>
        <!-- string builder micro optimizations, not relevant for this codebase -->
        <exclude name="AppendCharacterWithChar"/>
        <exclude name="ConsecutiveAppendsShouldReuse"/>
        <exclude name="ConsecutiveLiteralAppends"/>
        <exclude name="InsufficientStringBufferDeclaration"/>
        <!-- too many false positives for builder-style code -->
        <exclude name="AvoidInstantiatingObjectsInLoops"/>
        <!-- short literal concats are clearer than StringBuilder -->
        <exclude name="UseStringBufferForStringAppends"/>
        <!-- two-branch switch dispatch is intentional -->
        <exclude name="TooFewBranchesForSwitch"/>
    </rule>
    <rule ref="category/java/security.xml"/>
</ruleset>
