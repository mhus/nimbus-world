{
  "name": "@nimbus/engine",
  "version": "2.0.0",
  "description": "Nimbus Voxel Engine - 3D Engine (Viewer + Editor builds)",
  "type": "module",
  "main": "./dist/NimbusClient.js",
  "types": "./dist/NimbusClient.d.ts",
  "exports": {
    ".": {
      "types": "./dist/NimbusClient.d.ts",
      "default": "./dist/NimbusClient.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "scripts": {
    "dev": "vite --mode viewer --port 3000",
    "dev:editor": "vite --mode editor",
    "build": "pnpm build:viewer && pnpm build:editor && tsc",
    "typecheck": "tsc --noEmit",
    "build:viewer": "vite build --mode viewer",
    "build:editor": "vite build --mode editor",
    "preview": "vite preview",
    "preview:editor": "vite preview --outDir dist/editor",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.22.2",
    "@babylonjs/gui": "^9.22.2",
    "@babylonjs/loaders": "^9.22.2",
    "@babylonjs/materials": "^9.22.2",
    "@nimbus/shared": "workspace:*",
    "dotenv": "^17.2.3",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "babylonjs-gltf2interface": "^9.22.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "6.0.3",
    "vite": "^8.2.1"
  }
}
