{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@editors/*": ["./src/editors/*"],
      "@material/*": ["./src/material/*"],
      "@blocktype/*": ["./src/blocktype/*"],
      "@asset/*": ["./src/asset/*"],
      "@layer/*": ["./src/layer/*"],
      "@rule/*": ["./src/rule/*"],
      "@state/*": ["./src/state/*"],
      "@block/*": ["./src/block/*"],
      "@editconfig/*": ["./src/editconfig/*"],
      "@devlogin/*": ["./src/devlogin/*"],
      "@nimbus/shared": ["../shared/src/index.ts"],
      "@nimbus/shared/*": ["../shared/src/*"],
      "@shared": ["../shared/src/index.ts"],
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../shared" }
  ]
}
